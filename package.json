{
  "name": "kessler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit",
    "fetch:feeds": "tsx tools/fetch-feeds.ts",
    "gen:flavor": "tsx tools/gen-flavor.ts",
    "gen:boards": "tsx tools/gen-boards.ts",
    "audit:daily": "tsx tools/audit-daily.ts",
    "gen:campaign": "tsx tools/gen-campaign.ts",
    "check": "npm run lint && tsc --noEmit && npm run test && npm run build && npm run size"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@size-limit/file": "^11.2.0",
    "@types/node": "^26.6.6",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "size-limit": "^11.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "zod": "^4.6.7"
  },
  "size-limit": [
    {
      "path": "dist/assets/*.js",
      "limit": "300 kB",
      "gzip": true
    }
  ]
}
